<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 rounded-lg" Style="width: 100%;">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">Пријава</MudText>

        <MudForm @ref="form" @bind-IsValid="isValid" @bind-Errors="errors">
            <MudTextField T="string" Label="Корисничко име" Required="true" RequiredError="Корисничко име је неопходно!"
                          @bind-Value="username" Class="mb-4" />

            <MudTextField T="string" Label="Лозинка" Required="true" RequiredError="Лозинка је неопходна!"
                          @bind-Value="password" InputType="InputType.Password" Class="mb-6" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" @onclick="Login">Потврди</MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>