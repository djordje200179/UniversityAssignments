@page "/change-password"

@inject IAdminRepository adminRepository
@inject IPrompter prompter

<MudPaper Elevation="3" Class="pa-6 rounded-lg" MaxWidth="400px">
    <MudText Typo="Typo.h5" Class="mb-4">Промјена лозинке</MudText>

    <MudForm @ref="form">
        <MudTextField T="string" Label="Тренутна лозинка" Required="true"
                      RequiredError="Тренутна лозинка је неопходна!"
                      @bind-Value="currentPassword" InputType="InputType.Password" Class="mb-4" />

        <MudTextField T="string" Label="Нова лозинка" Required="true"
                      RequiredError="Нова лозинка је неопходна!"
                      @bind-Value="newPassword" InputType="InputType.Password" Class="mb-4" />

        <MudTextField T="string" Label="Потврда нове лозинке" Required="true"
                      RequiredError="Потврда лозинке је неопходна!"
                      @bind-Value="confirmPassword" InputType="InputType.Password" Class="mb-6"
                      Validation="@((string val) => val != newPassword ? "Лозинке се не подударају" : null)" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Submit"
                  Disabled="@(string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(confirmPassword))">Потврди</MudButton>
    </MudForm>
</MudPaper>

@code {
    private MudForm form = default!;
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    private async Task Submit() {
        await form.Validate();
        if (!form.IsValid)
            return;

        if (adminRepository.ChangePassword(currentPassword, newPassword)) {
            await prompter.ShowMessageAsync("Успјех", "Лозинка је успјешно промијењена.");
            currentPassword = string.Empty;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
        } else {
            await prompter.ShowAlertAsync("Грешка", "Тренутна лозинка није исправна.");
        }
    }
}
