<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:ClientApp.ViewModels"
			 xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ClientApp.Views.RideInfo"
			 x:DataType="vm:RideInfoViewModel"
             Title="Тренутна вожња">
	<Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
		<Border Padding="30" StrokeShape="RoundRectangle 12"
				Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
				BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
			<Border.Shadow>
				<Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.2" />
			</Border.Shadow>

			<VerticalStackLayout Spacing="16" WidthRequest="300">
				<Label Text="Тренутна вожња" FontSize="24" FontAttributes="Bold"
					   HorizontalTextAlignment="Center" Margin="0,0,0,8" />

				<Entry Placeholder="Вријеме почетка" IsEnabled="False" Text="{Binding Ride.StartTime, StringFormat='{0:HH:mm}'}" />
				<Entry Placeholder="Цијена изнајмљивања (РСД/h)" IsEnabled="False" Text="{Binding Ride.PricePerHour, StringFormat='{0:C}'}" />
				<Entry Placeholder="Тренутна цијена (РСД)" IsEnabled="False" Text="{Binding Ride.TotalPrice, StringFormat='{0:C}'}" />

				<Button Text="Заврши вожњу" Command="{Binding EndRideCommand}" Margin="0,8,0,0" />
				<Label Text="Предалеко сте од паркинга" FontAttributes="Italic"
					   HorizontalTextAlignment="Center"
					   IsVisible="{Binding CanEndRide, Converter={mct:InvertedBoolConverter}}" />
			</VerticalStackLayout>
		</Border>
	</Grid>
</ContentPage>