<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.SettingsView"
			 x:DataType="vm:SettingsViewModel"
             Title="Подешавања">
	<Page.ToolbarItems>
		<ToolbarItem Text="Одјава" IconImageSource="{FontImageSource Glyph='&#xf2f5;', FontFamily='FASolid'}"
					 Command="{Binding LogoutCommand}" />
	</Page.ToolbarItems>

	<ScrollView>
		<Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
			<Border Padding="30" StrokeShape="RoundRectangle 12"
					Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
					BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
				<Border.Shadow>
					<Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.2" />
				</Border.Shadow>

				<VerticalStackLayout Spacing="16" WidthRequest="300">
					<Label Text="Лични подаци" FontSize="20" FontAttributes="Bold"
						   HorizontalTextAlignment="Center" Margin="0,0,0,4" />

					<Entry Placeholder="Име" Text="{Binding FirstName}" />
					<Entry Placeholder="Презиме" Text="{Binding LastName}" />
					<Entry Placeholder="Корисничко име" Text="{Binding Username}" />
					<Entry Placeholder="Контакт телефон" Text="{Binding PhoneNumber}" />
					<Entry Placeholder="Имејл адреса" Text="{Binding EmailAddress}" />

					<Button Text="Ажурирај податке" Command="{Binding SaveChangesCommand}" Margin="0,8,0,0" />

					<BoxView HeightRequest="1" BackgroundColor="Gray" />

					<Label Text="Промјена лозинке" FontSize="20" FontAttributes="Bold"
						   HorizontalTextAlignment="Center" Margin="0,4,0,4" />

					<Entry Placeholder="Тренутна лозинка" IsPassword="True" Text="{Binding OldPassword}" />
					<Entry Placeholder="Нова лозинка" IsPassword="True" Text="{Binding NewPassword}" />
					<Entry Placeholder="Потврда нове лозинке" IsPassword="True" Text="{Binding ConfirmedNewPassword}" />

					<Button Text="Промјени лозинку" Command="{Binding ChangePasswordCommand}" Margin="0,8,0,0" />
				</VerticalStackLayout>
			</Border>
		</Grid>
	</ScrollView>
</ContentPage>