<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:ClientApp.ViewModels"
			 x:Class="ClientApp.Views.LoginView"
			 x:DataType="vm:LoginViewModel"
			 Title="Пријава">
	<Grid>
		<Image Source="background.png" Aspect="AspectFill" />

		<Border Padding="30" StrokeShape="RoundRectangle 12"
				VerticalOptions="Center" HorizontalOptions="Center" Margin="20"
				Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
				BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
			<Border.Shadow>
				<Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.2" />
			</Border.Shadow>

			<VerticalStackLayout Spacing="16" WidthRequest="300">
				<Label Text="Пријава" FontSize="24" FontAttributes="Bold"
					   HorizontalTextAlignment="Center" Margin="0,0,0,8" />

				<Entry Placeholder="Корисничко име" Text="{Binding Username}" />
				<Entry Placeholder="Лозинка" IsPassword="True" Text="{Binding Password}" />

				<Button Text="Login" Command="{Binding LoginCommand}" Margin="0,8,0,0" />

				<BoxView HeightRequest="1" BackgroundColor="Gray" />

				<Label TextColor="Blue" HorizontalTextAlignment="Center">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding RegisterCommand}" />
					</Label.GestureRecognizers>
					Немаш налог? Региструј се овдје.
				</Label>
			</VerticalStackLayout>
		</Border>
	</Grid>
</ContentPage>